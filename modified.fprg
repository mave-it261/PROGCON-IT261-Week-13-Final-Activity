    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Main function declares &quot;colors&quot; variable then calls the functions necessary to the program."/>
            <declare name="colors" type="String" array="True" size="7"/>
            <call expression="enterColors(colors)"/>
            <call expression="displayColors(colors)"/>
        </body>
    </function>
    <function name="displayColors" type="None" variable="">
        <parameters>
            <parameter name="colors" type="String" array="True"/>
        </parameters>
        <body>
            <comment text="&quot;displayColors&quot; function displays the seven variables inputted from enterColors function."/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;heres what you entered bro&quot;" newline="True"/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="colors[i]" newline="True"/>
            </for>
        </body>
    </function>
    <function name="enterColors" type="None" variable="">
        <parameters>
            <parameter name="colors" type="String" array="True"/>
        </parameters>
        <body>
            <comment text="&quot;enterColors&quot; function allows inputting 7 items in an array variable."/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="&quot;bruh would you mind entering the &quot; &#13;&#10; &amp; (i + 1) &amp; &quot; of the rainbow bro?&quot;" newline="True"/>
                <input variable="colors[i]"/>
            </for>
        </body>
    </function>
</flowgorithm>

    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="colors" type="String" array="True" size="7"/>
            <call expression="enterColors(colors)"/>
            <call expression="displayColors(colors)"/>
        </body>
    </function>
    <function name="displayColors" type="None" variable="">
        <parameters>
            <parameter name="colors" type="String" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;heres what you entered bro&quot;" newline="True"/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="colors[i]" newline="True"/>
            </for>
        </body>
    </function>
    <function name="enterColors" type="None" variable="">
        <parameters>
            <parameter name="colors" type="String" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="&quot;bruh would you mind entering the &quot; &#13;&#10; &amp; (i + 1) &amp; &quot; of the rainbow bro?&quot;" newline="True"/>
                <input variable="colors[i]"/>
            </for>
        </body>
    </function>
</flowgorithm>
