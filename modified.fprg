<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="array bitch ni rudim"/>
        <attribute name="authors" value="pejir"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-08 02:32:54 PM"/>
